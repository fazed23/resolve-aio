{
    Tools = ordered() {
        SoftLightLeak = MacroOperator {
            Inputs = ordered() {},
            Outputs = {
                MainOutput1 = InstanceOutput {
                    SourceOp = "LeakTransform",
                    Source = "Output",
                },
            },
            ViewInfo = GroupInfo { Pos = { 0, 0 } },
            Tools = ordered() {
                LeakBG = Background {
                    Inputs = {
                        Width = Input { Value = 1920 },
                        Height = Input { Value = 1080 },
                        TopLeftRed = Input { Value = 1 },
                        TopLeftGreen = Input { Value = 0.62 },
                        TopLeftBlue = Input { Value = 0.26 },
                        ["TopLeftAlpha"] = Input { SourceOp = "LeakAnim", Source = "Value" },
                    },
                },
                LeakTransform = Transform {
                    Inputs = {
                        Center = Input {
                            Value = { 0.15, 0.5 },
                            Expression = "Point(-0.1 + 0.5 * Blend, 0.5)",
                        },
                        Blend = Input { SourceOp = "LeakAnim", Source = "Value" },
                    },
                },
                LeakAnim = BezierSpline {
                    KeyFrames = {
                        [0] = { 0, RH = { 8, 0.33 }, Flags = { Linear = true } },
                        [14] = { 0.75, LH = { 6, 0.5 }, RH = { 6, 0.5 }, Flags = { Linear = true } },
                        [28] = { 0, LH = { 8, 0.33 }, Flags = { Linear = true } },
                    },
                },
            },
        },
    },
    ActiveTool = "SoftLightLeak",
}
