                    Default = "NEW DROP",
                },
                MainInput2 = InstanceInput {
                    SourceOp = "MainText",
                    Source = "StyledText",
                    Name = "Headline",
                    Default = "CINEMATIC PACK",
                },
            },
            Outputs = {
                MainOutput1 = InstanceOutput {
                    SourceOp = "GroupTransform",
                    Source = "Output",
                },
            },
            ViewInfo = GroupInfo { Pos = { 0, 0 } },
            Tools = ordered() {
                Canvas = Background {
                    Inputs = {
                        Width = Input { Value = 1920 },
                        Height = Input { Value = 1080 },
                        ["TopLeftAlpha"] = Input { Value = 0 },
                    },
                    ViewInfo = OperatorInfo { Pos = { 0, 0 } },
                },
                EyebrowText = TextPlus {
                    Inputs = {
                        Width = Input { Value = 1920 },
                        Height = Input { Value = 1080 },
                        StyledText = Input { Value = "NEW DROP" },
                        Font = Input { Value = "JetBrains Mono" },
                        Style = Input { Value = "Bold" },
                        Size = Input { Value = 0.032 },
                        Center = Input { Value = { 0.5, 0.58 } },
                        Red1 = Input { Value = 0.99 },
                        Green1 = Input { Value = 0.72 },
                        Blue1 = Input { Value = 0.25 },
                    },
                    ViewInfo = OperatorInfo { Pos = { 220, -40 } },
                },
                MainText = TextPlus {
                    Inputs = {
                        Width = Input { Value = 1920 },
                        Height = Input { Value = 1080 },
                        StyledText = Input { Value = "CINEMATIC PACK" },
                        Font = Input { Value = "Open Sans" },
                        Style = Input { Value = "Bold" },
                        Size = Input { Value = 0.08 },
                        Center = Input { Value = { 0.5, 0.49 } },
                        Red1 = Input { Value = 1 },
                        Green1 = Input { Value = 1 },
                        Blue1 = Input { Value = 1 },
                    },
                    ViewInfo = OperatorInfo { Pos = { 220, 40 } },
                },
                MergeEyebrow = Merge {
                    Inputs = {
                        Background = Input { SourceOp = "Canvas", Source = "Output" },
                        Foreground = Input { SourceOp = "EyebrowText", Source = "Output" },
                    },
                    ViewInfo = OperatorInfo { Pos = { 440, -20 } },
                },
                MergeMain = Merge {
                    Inputs = {
                        Background = Input { SourceOp = "MergeEyebrow", Source = "Output" },
                        Foreground = Input { SourceOp = "MainText", Source = "Output" },
                    },
                    ViewInfo = OperatorInfo { Pos = { 660, 0 } },
                },
                GroupTransform = Transform {
                    Inputs = {
                        Center = Input {
                            Value = { 0.5, 0.5 },
                            Expression = "Point(0.5, 0.57 - 0.07 * Blend)",
                        },
                        Blend = Input { SourceOp = "StompAnim", Source = "Value" },
                    },
                    ViewInfo = OperatorInfo { Pos = { 880, 0 } },
                },
                StompAnim = BezierSpline {
                    KeyFrames = {
                        [0] = { 0, RH = { 8, 0.33 }, Flags = { Linear = true } },
                        [14] = { 1, LH = { 8, 0.67 }, Flags = { Linear = true } },
                    },
                },
            },
        },
    },
    ActiveTool = "StompStack",
}
