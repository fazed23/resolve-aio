                },
            },
            Outputs = {
                MainOutput1 = InstanceOutput {
                    SourceOp = "SlideTransform",
                    Source = "Output",
                },
            },
            ViewInfo = GroupInfo { Pos = { 0, 0 } },
            Tools = ordered() {
