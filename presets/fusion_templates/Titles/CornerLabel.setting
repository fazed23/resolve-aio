                        TopLeftGreen = Input { Value = 0.47 },
                        TopLeftBlue = Input { Value = 0.19 },
                        ["TopLeftAlpha"] = Input { Value = 0.92 },
                    },
                    ViewInfo = OperatorInfo { Pos = { 220, 80 } },
                },
                LabelText = TextPlus {
                    Inputs = {
                        Width = Input { Value = 1920 },
                        Height = Input { Value = 1080 },
                        StyledText = Input { Value = "CHAPTER 01" },
                        Font = Input { Value = "JetBrains Mono" },
                        Style = Input { Value = "Bold" },
                        Size = Input { Value = 0.038 },
                        Center = Input { Value = { 0.165, 0.92 } },
                        HorizontalJustificationNew = Input { Value = 0 },
