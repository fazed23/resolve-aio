// Full to Legal — Converts data levels (0-255) to video levels (16-235)
// ResolveAIO DCTL Library
// Uses proper quantization equations per BT.709/BT.2020.

DEFINE_UI_PARAMS(p_BitDepth, Bit Depth, DCTLUI_COMBO_BOX, 0, {8-bit, 10-bit})

__DEVICE__ float full_to_legal(float x, int bit_depth) {
    // 8-bit: legal = 16 + x * (235 - 16) / 255 -> normalized: (16/255) + x * (219/255)
    // 10-bit: legal = 64 + x * (940 - 64) / 1023 -> normalized: (64/1023) + x * (876/1023)
    if (bit_depth == 0) {
        return (16.0f / 255.0f) + x * (219.0f / 255.0f);
    } else {
        return (64.0f / 1023.0f) + x * (876.0f / 1023.0f);
    }
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B) {
    float3 out;
    out.x = full_to_legal(p_R, p_BitDepth);
    out.y = full_to_legal(p_G, p_BitDepth);
    out.z = full_to_legal(p_B, p_BitDepth);
    return out;
}
